# Copy this file to .env.local and fill in values. Never commit real keys.

# Long random string used to sign session cookies (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database ---------------------------------------------------------------
# Leave these blank to use the built-in local file database (.data/db.json).
# The local database is for development and demos only. Vercel's filesystem is
# read-only, so production deployments must use Supabase.
SUPABASE_URL=
# Server-only key. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (NextStep AI Advisor) via fal.ai -------------------------------------
# Get a key at https://fal.ai/dashboard/keys . Leave blank to disable AI features
# (the rest of the site keeps working and shows a setup message).
FAL_KEY=
# Any model available on fal's OpenRouter endpoint.
AI_MODEL=openai/gpt-4o-mini
# Max AI requests per user per day (cost control).
AI_DAILY_LIMIT=20

# Set to "false" to hide demo accounts and demo-data banners.
DEMO_MODE=true
