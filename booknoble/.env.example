# Copy to .env.local (never commit real values). EXPO_PUBLIC_* values are
# bundled into the app and are safe to be public. Server secrets (Stripe,
# fal.ai, service role) belong ONLY in Supabase Edge Function secrets.

# Supabase project (Project Settings → API). The anon key is public by design;
# Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public web address where the booking pages are hosted, e.g. https://booknoble.app
EXPO_PUBLIC_WEB_URL=

# Optional: in-app subscriptions via RevenueCat (public SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional: Stripe Billing customer portal / checkout page for web subscriptions
EXPO_PUBLIC_STRIPE_BILLING_URL=
